{
  "name": "tasky-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:gateway": "wrangler pages deploy --cwd gateway --project-name tasky-homepage --branch main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:fixture": "tsx scripts/preview-fixture.ts"
  },
  "dependencies": {
    "@tasky/home-feed": "file:../packages/home-feed",
    "jose": "^6.1.3",
    "oauth4webapi": "^3.8.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  }
}
